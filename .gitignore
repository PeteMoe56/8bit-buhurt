Thumbs.db

# This project's own working files
_to_delete/
_git_locks_to_delete/
*.tgz

# Rendered screens are kept ON PURPOSE. `shots/` is evidence: half the findings
# in docs/REGISTER.md are "the screenshot showed something no test could see",
# and a repo that throws them away throws away the record of how the layout got
# the way it is. They are small, they diff usefully, and they stay.

# Test and tool logs
/logs/
__pycache__/

# Patches and renders handed over from Claude sessions; not part of the game.
Claude outputs/
logs/

# Upload/release keys never live in the repo (2 Oct 2026)
*.jks
*.keystore

# StoreKit addon: fetched by Codemagic for the iOS build (codemagic.yaml), never committed
/addons/GodotApplePlugins*/

