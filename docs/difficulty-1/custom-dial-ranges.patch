@@ -509,3 +510,29 @@ func _test_custom_is_your_own_dials() -> void:
 	_ok(clamped and reaches and kept, "custom is your own dials, clamped, fought and saved",
 		"dials %s; clamped %s, reach the fight and bills %s, survive a save %s"
 			% [str(cg), clamped, reaches, kept])
+
+
+## EASIER THAN EASIEST, HARDER THAN HARDEST (Pete, 9 Oct 2026). Every Custom dial
+## has to reach past the kindest preset in one direction and past the harshest
+## in the other, or the advanced settings are only the presets again. The free
+## swing is the one exception at its hard end: no swing at all (Hard List) is
+## the floor of a thing that cannot go below nothing.
+func _test_every_dial_reaches_past_the_presets() -> void:
+	var short: Array[String] = []
+	for key in Grade.EASIER:
+		var dir := int(Grade.EASIER[key])
+		var vals: Array = []
+		for g in Grade.TABLE:
+			vals.append(float(Grade.TABLE[g][key]))
+		var d: Array = Grade.DIALS[key]
+		var easiest_preset: float = vals.max() if dir > 0 else vals.min()
+		var hardest_preset: float = vals.min() if dir > 0 else vals.max()
+		var easiest_dial: float = float(d[1]) if dir > 0 else float(d[0])
+		var hardest_dial: float = float(d[0]) if dir > 0 else float(d[1])
+		var easier_ok: bool = (easiest_dial - easiest_preset) * dir > 0.0
+		var harder_ok: bool = (hardest_preset - hardest_dial) * dir > 0.0 \
+			or (key == "swing" and is_equal_approx(hardest_dial, 0.0))
+		if not (easier_ok and harder_ok):
+			short.append("%s (presets %s, dial %s..%s)" % [key, str(vals), d[0], d[1]])
+	_ok(short.is_empty(), "every Custom dial reaches past the easiest and the hardest preset",
+		"all %d dials" % Grade.EASIER.size() if short.is_empty() else ", ".join(short))
