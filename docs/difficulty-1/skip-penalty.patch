diff --git a/scripts/league/season_bouts.gd b/scripts/league/season_bouts.gd
index 54bc70a..bb44d02 100644
--- a/scripts/league/season_bouts.gd
+++ b/scripts/league/season_bouts.gd
@@ -694,7 +694,10 @@ static func skip_event(s: Season) -> void:
 	## read only by `MeleeSim`, so pressing SIM IT fought the season at no
 	## difficulty at all and five twenty-season careers at five different grades
 	## came back identical.
-	s.world.player_scale = s.opposition_scale(opp)
+	## A SKIPPED BOUT IS HARDER (Pete, 9 Oct 2026: skipping should add "about
+	## 3-4 seasons onto it if you're habitual with it"). Only bouts the player
+	## skips; a fought bout never sees it, and an occasional skip costs little.
+	s.world.player_scale = s.opposition_scale(opp) * Season.SKIP_HANDICAP
 	s.world.play_week()
 	s.world.player_scale = 1.0
 	var now := s._my_row()
