+const HARNESS_DRAW := [0.0, .01, .025, .04, .06]
+
 static func set_draws(o: ClubOffice, eight: Array) -> void:
 	o._draws.clear()
 	for f in eight:
 		var d := FighterTrait.mod(f.trait_id, "turnout", 0.0)
+		d += float(HARNESS_DRAW[Quartermaster.grade_of(f)]) * clampf(f.armor, 0.0, 1.0)
 		if d > 0.0:
 			o._draws.append(d)
 
