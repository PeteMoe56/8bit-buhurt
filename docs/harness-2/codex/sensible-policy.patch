+	## Visible-age policy: development first, young starting five, through Hardened.
+	## Same reserve plus the new wage; no gifts, hidden-ceiling use or extra repairs.
+	func _sensible_harness(s: Season, keep: int) -> void:
+		var o := s.office
+		var best_a: Dictionary = {}
+		for a in Armorer.pool(s.seed_value, s.world.season, String(o.armorer.get("name", ""))):
+			var st := int(a.get("stars", 1))
+			if st > 3 or st <= int(o.armorer.get("stars", 1)) or not Armorer.will_come(st, o.tier):
+				continue
+			var fee := Armorer.wage_of(a)
+			var extra_wage := maxi(0, fee - Armorer.wage_of(o.armorer))
+			if o.credits <= keep + fee + extra_wage:
+				audit.skipped("armorer_hire", "sensible_reserve", {"candidate": a, "keep": keep})
+				continue
+			if best_a.is_empty() or st > int(best_a.get("stars", 1)):
+				best_a = a
+		if not best_a.is_empty() and o.hire_armorer(best_a) == "":
+			harness_cc += Armorer.wage_of(best_a)
+		keep = o.upkeep_bill() + League.dues_for(o.tier) + KITTY
+		if not o.fixture_week:
+			audit.skipped("harness_upgrade", "not_fixture_week")
+			return
+		var five: Array = s.club.starting_five()
+		five.sort_custom(func(a, b):
+			if Quartermaster.grade_of(a) == Quartermaster.grade_of(b):
+				return a.age < b.age
+			return Quartermaster.grade_of(a) < Quartermaster.grade_of(b))
+		for f in five:
+			if f.age > 30 or Quartermaster.grade_of(f) >= Quartermaster.Grade.FITTED:
+				audit.skipped("harness_upgrade", "sensible_age_or_target", {"fighter": audit.card(f)})
+				continue
+			var cost := Quartermaster.upgrade_cost(f)
+			if o.credits <= keep + cost:
+				audit.skipped("harness_upgrade", "reserve", {"fighter": audit.card(f), "keep": keep, "cost": cost})
+				continue
+			if o.buy_harness(f) == "":
+				harness_cc += cost
+			break
