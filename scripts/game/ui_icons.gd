## THE SMALL PAIR — 8x8, and this is a second SIZE rather than an exception.
##
## The game's grid is 8. A star beside a name in a table wants to be 8 pixels and
## a star on a fighter's card wants to be 16, and scaling one grid to the other
## is how you get a star with a half-pixel point on it. So there are two grids,
## both on the grid, and `UiKit.stars()` picks by the size it was asked for.
##
## Only the star has a small cut, because only the star is ever drawn in a table
## row. Anything else that needs one gets added here the day it does.
const SMALL_GRID: int = 8

const SMALL := {
	"star": [
		"...##...",
		"...##...",
		"########",
		".######.",
		"..####..",
		".##..##.",
		"##....##",
		"........",
	],
	"star_half": [
		"...#....",
		"...#....",
		"####....",
		".###....",
		"..##....",
		".##.....",
		"##......",
		"........",
	],
}


## RUNS, NOT PIXELS. A naive icon is up to 256 `draw_rect` calls and a screen
## with twenty of them is five thousand — on a phone, at sixty frames a second,
## for decoration. So each mark's ink is merged into horizontal runs, grown
## downward while the row below is identical, and the result is cached the first
## time anybody asks. A typical mark comes out around thirty rects.
##
## Same technique the typeface builder uses on the same kind of data, for the
## same reason.
static var _runs := {}


static func runs(name: String, small: bool = false) -> Array:
	var key := ("s:" if small else "m:") + name
	if _runs.has(key):
		return _runs[key]
	var table: Dictionary = SMALL if small else MARKS
	var g: int = SMALL_GRID if small else GRID
	var rows: Array = table.get(name, [])
	var out: Array = []
	if rows.is_empty():
		_runs[key] = out
		return out
	var used := []
	for y in g:
		used.append([])
		for x in g:
			used[y].append(false)
	for y in g:
		var row := String(rows[y])
		var x := 0
		while x < g:
			if row[x] != "#" or used[y][x]:
				x += 1
				continue
			var x2 := x
			while x2 + 1 < g and row[x2 + 1] == "#" and not used[y][x2 + 1]:
				x2 += 1
			var y2 := y
			while y2 + 1 < g:
				var below := String(rows[y2 + 1])
				var same := true
				for i in range(x, x2 + 1):
					if below[i] != "#" or used[y2 + 1][i]:
						same = false
						break
				if not same:
					break
				y2 += 1
			for yy in range(y, y2 + 1):
				for xx in range(x, x2 + 1):
					used[yy][xx] = true
			out.append(Rect2(float(x), float(y), float(x2 - x + 1), float(y2 - y + 1)))
			x = x2 + 1
	_runs[key] = out
	return out


## DRAW ONE. `at` is the top-left corner and it is snapped, because a mark at
## x=12.5 is a soft mark and one soft mark makes a whole screen look soft.
static func draw(ci: CanvasItem, name: String, at: Vector2, col: Color,
		scale: int = 1, small: bool = false) -> void:
	var s := float(maxi(1, scale))
	var o := Vector2(roundf(at.x), roundf(at.y))
	for r in runs(name, small):
		var rr: Rect2 = r
		ci.draw_rect(Rect2(o + rr.position * s, rr.size * s), col)


## THE SAME MARK AS A TEXTURE, for the places that need one — a `Button`'s
## `icon` property wants a `Texture2D` and will not take a draw call.
##
## Cached on name+color+scale, because building an image per frame for a button
## that never changes is the kind of thing that is invisible on a desktop and
## halves the frame rate on a phone.
static var _textures := {}


static func texture(name: String, col: Color, scale: int = 1) -> Texture2D:
	var key := "%s|%s|%d" % [name, col.to_html(false), scale]
	if _textures.has(key):
		return _textures[key]
	var s := maxi(1, scale)
	var img := Image.create(GRID * s, GRID * s, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for r in runs(name):
		var rr: Rect2 = r
		img.fill_rect(Rect2i(int(rr.position.x) * s, int(rr.position.y) * s,
			int(rr.size.x) * s, int(rr.size.y) * s), col)
	var tex := ImageTexture.create_from_image(img)
	_textures[key] = tex
	return tex


static func has(name: String) -> bool:
	return MARKS.has(name)


static func names() -> Array:
	return MARKS.keys()
